{
    "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
    "format": 1,
    "name": "MLB The Show 26",
    "repo": "sam110411/fastball",
    "min": "0.90.0-beta.27",
    "requires": [
        "start",
        "exit_codes",
        "settings.ini",
        "settings.choices",
        "settings.slider",
        "settings.groups"
    ],
    "inputs": [
        {
            "id": "base",
            "label": "Your MLB The Show 26 game (base NSP)",
            "role": "game",
            "formats": [
                {
                    "type": "file",
                    "extensions": [
                        "nsp"
                    ],
                    "requires": [
                        "keys"
                    ]
                }
            ]
        },
        {
            "id": "update",
            "label": "The 1.0.20 or 1.0.15 update (NSP)",
            "role": "update",
            "formats": [
                {
                    "type": "file",
                    "extensions": [
                        "nsp"
                    ],
                    "requires": [
                        "keys"
                    ]
                }
            ]
        },
        {
            "id": "keys",
            "label": "Nintendo Switch prod.keys",
            "role": "key",
            "shared": "switch.prod-keys"
        }
    ],
    "prepare": {
        "program": [
            "python/python.exe"
        ],
        "args": [
            "-m",
            "installer",
            "--base",
            "{input:base}",
            "--update",
            "{input:update}",
            "--keys",
            "{input:keys}",
            "--dest",
            "{install}/MLBTS",
            "--launcher"
        ],
        "label": "Building the game from your files",
        "timeout": 10800,
        "options": [
            {
                "id": "dlss",
                "label": "NVIDIA DLSS",
                "note": "Downloads NVIDIA's DLSS file for RTX cards.",
                "args": [
                    "--dlss"
                ],
                "os": [
                    "windows"
                ],
                "gpu": "nvidia",
                "license": {
                    "name": "NVIDIA RTX SDKs License",
                    "url": "https://github.com/NVIDIA/DLSS/blob/main/LICENSE.txt"
                }
            },
            {
                "id": "ryujinx_save",
                "label": "Bring over my Ryujinx save",
                "note": "Copies your save from Ryujinx, if you have one.",
                "args": [
                    "--import-save"
                ],
                "os": [
                    "windows"
                ]
            },
            {
                "id": "rtts_equipment",
                "label": "Road to the Show equipment",
                "note": "Adds every equipment item to Road to the Show, offline and owned from the start. Takes a few minutes.",
                "args": [
                    "--equipment"
                ],
                "os": [
                    "windows"
                ]
            },
            {
                "id": "rtts_packages",
                "label": "Road to the Show packages",
                "note": "Equipment comes from packs you earn in Road to the Show, as it does online, without a connection. Adds the equipment, not owned at the start.",
                "args": [
                    "--packages"
                ],
                "os": [
                    "windows"
                ]
            }
        ]
    },
    "start": {
        "program": [
            "MLBTS/mlb.exe",
            "Fastball.exe",
            "MLBTS-Setup.exe"
        ]
    },
    "exit_codes": {
        "1": "The game stopped with an error. Its log is in MLBTS/logs/mlb.log."
    },
    "config": [
        {
            "id": "main",
            "format": "ini",
            "file": [
                {
                    "path": "{install}/MLBTS/mlb.cfg"
                }
            ]
        }
    ],
    "saves": [
        "{install}/MLBTS/profile"
    ],
    "folders": {
        "saves": [
            {
                "path": "{install}/MLBTS/profile"
            }
        ],
        "logs": [
            {
                "path": "{install}/MLBTS/logs"
            }
        ]
    },
    "settings": [
        {
            "id": "fullscreen",
            "label": "Window mode",
            "group": "Display",
            "help": "Fullscreen or a window.",
            "choices": [
                {
                    "label": "Fullscreen",
                    "set": {
                        "MLB_FULLSCREEN": "1"
                    }
                },
                {
                    "label": "Window",
                    "set": {
                        "MLB_FULLSCREEN": "0"
                    }
                }
            ],
            "defaults": {
                "MLB_FULLSCREEN": "0"
            }
        },
        {
            "id": "output_res",
            "label": "Resolution",
            "group": "Display",
            "help": "The size the game draws its picture at. Higher is sharper and needs a faster graphics card.",
            "choices": [
                {
                    "label": "1280x720",
                    "set": {
                        "MLB_OUTPUT_RES": "1280x720"
                    }
                },
                {
                    "label": "1920x1080",
                    "set": {
                        "MLB_OUTPUT_RES": "1920x1080"
                    }
                },
                {
                    "label": "2560x1440",
                    "set": {
                        "MLB_OUTPUT_RES": "2560x1440"
                    }
                },
                {
                    "label": "3840x2160",
                    "set": {
                        "MLB_OUTPUT_RES": "3840x2160"
                    }
                }
            ],
            "defaults": {
                "MLB_OUTPUT_RES": "1920x1080"
            }
        },
        {
            "id": "render_scale",
            "label": "Render scale",
            "group": "Display",
            "help": "How much of the resolution the 3D scene is drawn at. Game keeps the game's own scale.",
            "choices": [
                {
                    "label": "Game",
                    "set": {
                        "MLB_RENDER_SCALE": "game"
                    }
                },
                {
                    "label": "100%",
                    "set": {
                        "MLB_RENDER_SCALE": "100"
                    }
                },
                {
                    "label": "125%",
                    "set": {
                        "MLB_RENDER_SCALE": "125"
                    }
                },
                {
                    "label": "150%",
                    "set": {
                        "MLB_RENDER_SCALE": "150"
                    }
                }
            ],
            "defaults": {
                "MLB_RENDER_SCALE": "game"
            }
        },
        {
            "id": "present",
            "label": "V-Sync",
            "group": "Display",
            "help": "Mailbox is smooth with no tearing. V-Sync locks to the display. Off can tear.",
            "choices": [
                {
                    "label": "Mailbox",
                    "set": {
                        "MLB_VK_PRESENT": "mailbox"
                    }
                },
                {
                    "label": "V-Sync",
                    "set": {
                        "MLB_VK_PRESENT": "fifo"
                    }
                },
                {
                    "label": "Off",
                    "set": {
                        "MLB_VK_PRESENT": "immediate"
                    }
                }
            ],
            "defaults": {
                "MLB_VK_PRESENT": "mailbox"
            }
        },
        {
            "id": "fps_limit",
            "label": "Frame rate limit",
            "group": "Display",
            "help": "60 is the game's own. The game plays at the same speed at any limit. Above your monitor's refresh rate it only helps with Mailbox or Off.",
            "choices": [
                {"label": "30", "set": {"MLB_FPS_LIMIT": "30"}},
                {"label": "60", "set": {"MLB_FPS_LIMIT": "60"}},
                {"label": "90", "set": {"MLB_FPS_LIMIT": "90"}},
                {"label": "120", "set": {"MLB_FPS_LIMIT": "120"}},
                {"label": "144", "set": {"MLB_FPS_LIMIT": "144"}},
                {"label": "165", "set": {"MLB_FPS_LIMIT": "165"}},
                {"label": "240", "set": {"MLB_FPS_LIMIT": "240"}},
                {"label": "Monitor refresh rate", "set": {"MLB_FPS_LIMIT": "display"}}
            ],
            "defaults": {
                "MLB_FPS_LIMIT": "60"
            }
        },
        {
            "id": "aspect",
            "label": "Aspect ratio",
            "group": "Display",
            "choices": [
                {
                    "label": "Fit",
                    "set": {
                        "MLB_ASPECT": "fit"
                    }
                },
                {
                    "label": "Stretch",
                    "set": {
                        "MLB_ASPECT": "stretch"
                    }
                }
            ],
            "defaults": {
                "MLB_ASPECT": "fit"
            }
        },
        {
            "id": "hdr",
            "label": "HDR",
            "group": "Display",
            "help": "HDR10 output. Needs an HDR display with HDR switched on in Windows.",
            "choices": [
                {
                    "label": "Off",
                    "set": {
                        "MLB_HDR": "0"
                    }
                },
                {
                    "label": "On",
                    "set": {
                        "MLB_HDR": "1"
                    }
                }
            ],
            "defaults": {
                "MLB_HDR": "0"
            }
        },
        {
            "id": "dlss",
            "label": "DLSS",
            "group": "Graphics",
            "help": "NVIDIA RTX cards only. DLAA keeps the full resolution; the others draw fewer pixels for more frames per second.",
            "choices": [
                {
                    "label": "Off",
                    "set": {
                        "MLB_DLSS": "off"
                    }
                },
                {
                    "label": "DLAA",
                    "set": {
                        "MLB_DLSS": "dlaa"
                    }
                },
                {
                    "label": "Quality",
                    "set": {
                        "MLB_DLSS": "quality"
                    }
                },
                {
                    "label": "Balanced",
                    "set": {
                        "MLB_DLSS": "balanced"
                    }
                },
                {
                    "label": "Performance",
                    "set": {
                        "MLB_DLSS": "performance"
                    }
                },
                {
                    "label": "Ultra Performance",
                    "set": {
                        "MLB_DLSS": "ultra_performance"
                    }
                }
            ],
            "defaults": {
                "MLB_DLSS": "off"
            }
        },
        {
            "id": "fsr",
            "label": "AMD FSR",
            "group": "Graphics",
            "help": "AMD FSR 3.1, or FSR 4 on the Radeon cards that run it, for any graphics card. Native AA keeps the full resolution; the others draw fewer pixels for more frames per second. When DLSS is on too, DLSS is used.",
            "choices": [
                {
                    "label": "Off",
                    "set": {
                        "MLB_FSR": "off"
                    }
                },
                {
                    "label": "Native AA",
                    "set": {
                        "MLB_FSR": "native"
                    }
                },
                {
                    "label": "Quality",
                    "set": {
                        "MLB_FSR": "quality"
                    }
                },
                {
                    "label": "Balanced",
                    "set": {
                        "MLB_FSR": "balanced"
                    }
                },
                {
                    "label": "Performance",
                    "set": {
                        "MLB_FSR": "performance"
                    }
                },
                {
                    "label": "Ultra Performance",
                    "set": {
                        "MLB_FSR": "ultra_performance"
                    }
                }
            ],
            "defaults": {
                "MLB_FSR": "off"
            }
        },
        {
            "id": "upscaler",
            "label": "Upscaler",
            "group": "Graphics",
            "help": "How the picture is scaled to the window. Bilinear is the game's own look; FSR 1 is sharper.",
            "choices": [
                {
                    "label": "Bilinear",
                    "set": {
                        "MLB_UPSCALER": "bilinear"
                    }
                },
                {
                    "label": "FSR 1",
                    "set": {
                        "MLB_UPSCALER": "fsr"
                    }
                }
            ],
            "defaults": {
                "MLB_UPSCALER": "bilinear"
            }
        },
        {
            "id": "aa",
            "label": "Anti-aliasing",
            "group": "Graphics",
            "choices": [
                {
                    "label": "FXAA",
                    "set": {
                        "MLB_AA": "fxaa"
                    }
                },
                {
                    "label": "Off",
                    "set": {
                        "MLB_AA": "off"
                    }
                }
            ],
            "defaults": {
                "MLB_AA": "fxaa"
            }
        },
        {
            "id": "shadows",
            "label": "Shadow quality",
            "group": "Graphics",
            "choices": [
                {
                    "label": "Game",
                    "set": {
                        "MLB_SHADOW_RES": "game"
                    }
                },
                {
                    "label": "1024",
                    "set": {
                        "MLB_SHADOW_RES": "1024"
                    }
                },
                {
                    "label": "1536",
                    "set": {
                        "MLB_SHADOW_RES": "1536"
                    }
                },
                {
                    "label": "2048",
                    "set": {
                        "MLB_SHADOW_RES": "2048"
                    }
                }
            ],
            "defaults": {
                "MLB_SHADOW_RES": "game"
            }
        },
        {
            "id": "aniso",
            "label": "Texture filtering",
            "group": "Graphics",
            "choices": [
                {
                    "label": "Game",
                    "set": {
                        "MLB_ANISO": "game"
                    }
                },
                {
                    "label": "4x",
                    "set": {
                        "MLB_ANISO": "4"
                    }
                },
                {
                    "label": "8x",
                    "set": {
                        "MLB_ANISO": "8"
                    }
                },
                {
                    "label": "16x",
                    "set": {
                        "MLB_ANISO": "16"
                    }
                }
            ],
            "defaults": {
                "MLB_ANISO": "game"
            }
        },
        {
            "id": "fov",
            "label": "Field of view",
            "group": "Graphics",
            "slider": {
                "key": "MLB_FOV",
                "min": 70,
                "max": 140,
                "step": 5,
                "format": "%d"
            },
            "defaults": {
                "MLB_FOV": "100"
            }
        },
        {
            "id": "overlay",
            "label": "Performance overlay",
            "group": "Graphics",
            "choices": [
                {
                    "label": "Off",
                    "set": {
                        "MLB_PERF_OVERLAY": "off"
                    }
                },
                {
                    "label": "FPS",
                    "set": {
                        "MLB_PERF_OVERLAY": "fps"
                    }
                },
                {
                    "label": "Full",
                    "set": {
                        "MLB_PERF_OVERLAY": "full"
                    }
                }
            ],
            "defaults": {
                "MLB_PERF_OVERLAY": "off"
            }
        },
        {
            "id": "volume",
            "label": "Volume",
            "group": "Sound",
            "slider": {
                "key": "MLB_VOLUME",
                "min": 0,
                "max": 100,
                "step": 5,
                "format": "%d"
            },
            "defaults": {
                "MLB_VOLUME": "100"
            }
        },
        {
            "id": "prompts",
            "label": "Button prompts",
            "group": "Controls",
            "help": "Whose buttons the game shows. Auto follows the controller.",
            "choices": [
                {
                    "label": "Auto",
                    "set": {
                        "MLB_PROMPTS": "auto"
                    }
                },
                {
                    "label": "Xbox",
                    "set": {
                        "MLB_PROMPTS": "xbox"
                    }
                },
                {
                    "label": "PlayStation",
                    "set": {
                        "MLB_PROMPTS": "playstation"
                    }
                },
                {
                    "label": "Nintendo",
                    "set": {
                        "MLB_PROMPTS": "nintendo"
                    }
                }
            ],
            "defaults": {
                "MLB_PROMPTS": "auto"
            }
        },
        {
            "id": "rumble",
            "label": "Vibration",
            "group": "Controls",
            "choices": [
                {
                    "label": "On",
                    "set": {
                        "MLB_RUMBLE": "1"
                    }
                },
                {
                    "label": "Off",
                    "set": {
                        "MLB_RUMBLE": "0"
                    }
                }
            ],
            "defaults": {
                "MLB_RUMBLE": "1"
            }
        },
        {
            "id": "pad_driver",
            "label": "Controller driver",
            "group": "Controls",
            "advanced": true,
            "help": "SDL works with Xbox and PlayStation controllers. XInput is Xbox only.",
            "choices": [
                {
                    "label": "SDL",
                    "set": {
                        "MLB_PAD_DRIVER": "sdl"
                    }
                },
                {
                    "label": "XInput",
                    "set": {
                        "MLB_PAD_DRIVER": "xinput"
                    }
                }
            ],
            "defaults": {
                "MLB_PAD_DRIVER": "sdl"
            }
        },
        {
            "id": "mode",
            "label": "Console mode",
            "group": "Controls",
            "advanced": true,
            "choices": [
                {
                    "label": "Docked",
                    "set": {
                        "MLB_OPERATION_MODE": "docked"
                    }
                },
                {
                    "label": "Handheld",
                    "set": {
                        "MLB_OPERATION_MODE": "handheld"
                    }
                }
            ],
            "defaults": {
                "MLB_OPERATION_MODE": "docked"
            }
        }
    ]
}
